<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Same store as Athena.Ingestion: one 'dotnet user-secrets set' serves both CLIs. -->
    <UserSecretsId>2fd374a8-4ad1-4156-8aae-b443af334762</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Athena.Core\Athena.Core.csproj" />
    <ProjectReference Include="..\Athena.Ingestion\Athena.Ingestion.csproj" />
    <ProjectReference Include="..\Athena.Retrieval\Athena.Retrieval.csproj" />
    <ProjectReference Include="..\Athena.Recommendation\Athena.Recommendation.csproj" />
    <!-- lambda-sweep drives the real RecommendPlugin end-to-end. -->
    <ProjectReference Include="..\Athena.Plugins\Athena.Plugins.csproj" />
    <!-- routing drives the real agent (Part E evidence run). -->
    <ProjectReference Include="..\Athena.Agent\Athena.Agent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Judge/metric parse helpers are unit-tested directly. -->
    <InternalsVisibleTo Include="Athena.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <!-- QaAnswerSource loads prompts/answer.yaml exactly as SearchPlugin does. -->
    <PackageReference Include="Microsoft.SemanticKernel.Yaml" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
    <PackageReference Include="Microsoft.SemanticKernel" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.OpenAI" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.InMemory" />
  </ItemGroup>

</Project>
