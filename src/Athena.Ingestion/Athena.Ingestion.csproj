<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>2fd374a8-4ad1-4156-8aae-b443af334762</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Athena.Core\Athena.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure internal helpers (centroid arithmetic, composite text, JSON parsing) are
         unit-tested directly without widening the public surface. -->
    <InternalsVisibleTo Include="Athena.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Azure DI is the sole extractor (prebuilt-layout, one cached call per document).
         Docnet.Core only manufactures the scanned test PDF; it never extracts. -->
    <PackageReference Include="Azure.AI.DocumentIntelligence" />
    <PackageReference Include="Docnet.Core" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Console logger for the CLI composition root only; library code stays on Abstractions. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <!-- Sprint 2: chunk windows are measured in cl100k tokens (what the embedding model sees). -->
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" />
    <!-- Sprint 2: the pipeline embeds chunks and writes vector-store collections (§6.5), and the
         summariser wraps an SK prompt function. Core stays clean; Ingestion may reference SK. -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
    <PackageReference Include="Microsoft.SemanticKernel" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.OpenAI" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.InMemory" />
  </ItemGroup>

</Project>
